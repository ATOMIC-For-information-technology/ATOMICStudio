# Live provider probe output (real generations, real cost) — never committed
.live-probe/

# tsc incremental caches — regenerated by every typecheck run.
*.tsbuildinfo

# Electron runtime state from local test runs (Chromium cache, Trust Tokens, screenshots).
# 27MB of binaries that must never enter git history.
.local-cloud/

# Regenerable design-review screenshots (3.4MB of PNGs).
apps/desktop/.impeccable/review/

# The UI suite writes examples/hello-vite/src/{leak.js,w16blind.tsx} on every run. They are NOT
# tracked and deliberately NOT ignored either: step 14e2 counts changed files in that folder, and
# `git status` does not report ignored paths — ignoring them would break the step just as surely as
# committing them did.

# Agent/tool working directories — local session state, regenerable, never committed.
# .graphify/ in particular carries cache/ and a 5 MB graph rebuilt by `graphify`.
.claude/
.cursor/
.graphify/
.playwright-mcp/
