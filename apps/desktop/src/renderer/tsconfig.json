{
  "extends": "../../tsconfig.web.json",
  "compilerOptions": {
    "incremental": true,
    "jsx": "preserve",
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "../shared/**/*.ts",
    "../preload/**/*.d.ts"
  ],
  "exclude": ["node_modules", "out"]
}
